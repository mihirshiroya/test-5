// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  password               String?   // Optional for Google OAuth users
  firstName              String
  lastName               String
  isEmailVerified        Boolean   @default(false)
  isActive               Boolean   @default(true)
  role                   UserRole  @default(USER)
  provider               AuthProvider @default(LOCAL)
  googleId               String?   @unique
  avatar                 String?
  lastLoginAt            DateTime?
  emailVerifiedAt        DateTime?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  emailVerificationToken String?

  refreshTokens          RefreshToken[]
  workspaces             Workspace[]
  tasks                  Task[]
  taskSessions           TaskSession[]
  dailyAnalytics         DailyAnalytics[]
  notes                  Note[]

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Workspace {
  id          String   @id @default(uuid())
  userId      String

  name        String
  description String?

  // Folder appearance (keys from components/Ui/project-data)
  tint        String   @default("lavender")
  icon        String   @default("folder")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("workspaces")
}

// ============================================================
// TASK
// ============================================================

model Task {
  id                     String         @id @default(uuid())

  // Foreign keys
  userId                 String
  workspaceId            String

  // Task information
  title                  String
  description            String

  status                 TaskStatus
  priority               TaskPriority

  // Kanban/order position
  position               Int

  // Planned task period
  startDate              DateTime?
  deadlineDate           DateTime?

  // Time tracking
  plannedDurationSeconds Int            @default(0)
  actualDurationSeconds  Int            @default(0)

  // Task lifecycle
  startedAt              DateTime?
  completedAt            DateTime?

  // Relationships
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace              Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  sessions               TaskSession[]
  activities             DailyActivity[]

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Indexes
  @@index([userId])
  @@index([workspaceId])
  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([userId, deadlineDate])
  @@index([workspaceId, deadlineDate])

  @@map("tasks")
}

// ============================================================
// TASK SESSION
// ============================================================

model TaskSession {
  id              String    @id @default(uuid())

  // Foreign keys
  userId          String
  taskId          String

  // Timer information
  startedAt       DateTime
  endedAt         DateTime?

  durationSeconds Int?

  // Relationships
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Indexes
  @@index([userId])
  @@index([taskId])
  @@index([userId, startedAt])
  @@index([taskId, startedAt])

  @@map("task_sessions")
}

// ============================================================
// DAILY ANALYTICS
// ============================================================

model DailyAnalytics {
  id                 String   @id @default(uuid())

  // Foreign key
  userId             String

  // One calendar day
  analyticsDate      DateTime @db.Date

  // Daily task statistics
  createdTaskCount   Int      @default(0)
  completedTaskCount Int      @default(0)

  // Daily focus statistics
  totalSessions      Int      @default(0)
  totalFocusSeconds  Int      @default(0)

  // Relationships
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activities         DailyActivity[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // One analytics row per user per day
  @@unique([userId, analyticsDate])
  @@index([userId])
  @@index([userId, analyticsDate])

  @@map("daily_analytics")
}

// ============================================================
// DAILY ACTIVITY
// ============================================================

model DailyActivity {
  id               String         @id @default(uuid())

  // Foreign keys
  dailyAnalyticsId String

  // Nullable so historical activity survives task deletion
  taskId           String?

  // Activity information
  type             ActivityType
  metadata         Json?

  // Relationships
  dailyAnalytics   DailyAnalytics @relation(fields: [dailyAnalyticsId], references: [id], onDelete: Cascade)
  task             Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt        DateTime       @default(now())

  // Indexes
  @@index([dailyAnalyticsId])
  @@index([taskId])
  @@index([dailyAnalyticsId, type])

  @@map("daily_activities")
}

// ============================================================
// NOTES
// ============================================================

model Note {
  id        String   @id @default(uuid())

  userId    String

  title     String

  tint      NoteTint @default(blue)
  icon      NoteIcon @default(folder)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  topics    Topic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("notes")
}

model Topic {
  id        String     @id @default(uuid())
  noteId    String
  title     String
  position  Int        @default(0)

  note      Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  subtopics Subtopic[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([noteId])
  @@map("topics")
}

model Subtopic {
  id          String    @id @default(uuid())

  topicId     String

  title       String
  description String?
  position    Int       @default(0)

  topic       Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content     Content[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([topicId])
  @@map("subtopics")
}

model Content {
  id         String      @id @default(uuid())

  subtopicId String

  title      String
  type       ContentType
  content    String      @db.Text
  language   String?
  position   Int         @default(0)

  subtopic   Subtopic    @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([subtopicId])
  @@map("contents")
}

// ============================================================
// ENUMS
// ============================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityType {
  TASK_CREATED
  TASK_COMPLETED
  TASK_STARTED
  TASK_UPDATED
  TASK_DELETED

  SESSION_STARTED
  SESSION_COMPLETED

  STATUS_CHANGED
  PRIORITY_CHANGED
  DEADLINE_CHANGED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ContentType {
  text
  code
}

// Must match TintKey in components/Ui/folder-data.tsx
enum NoteTint {
  blue
  violet
  pink
  amber
  emerald
  rose
  cyan
  lime
}

// Must match IconKey in components/Ui/folder-data.tsx
enum NoteIcon {
  folder
  doc
  image
  star
  work
  heart
  code
  music
  rocket
  camera
}
